# ==============================================================================
# DocuMind AI Microservice Configuration
# ==============================================================================

ENVIRONMENT=development

# OpenAI API Settings
OPENAI_API_KEY=your-openai-api-key-here

# Azure OpenAI Settings (Used when USE_AZURE_OPENAI=true)
USE_AZURE_OPENAI=false
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Database Connection (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://documind:documind_password@localhost:5432/documind

# Shared Internal Secret for .NET API <-> FastAPI authentication
INTERNAL_API_KEY=dev_internal_secret_key_32_characters

# AI Pipeline Hyperparameters
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_CHUNKS_PER_QUERY=8
MAX_FILE_SIZE_MB=50

