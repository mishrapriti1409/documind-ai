# DocuMind AI - Environment Configuration

# Database (PostgreSQL with pgvector)
POSTGRES_DB=documind
POSTGRES_USER=documind_user
POSTGRES_PASSWORD=documind_secret
DATABASE_URL=postgresql+asyncpg://documind_user:documind_secret@localhost:5432/documind
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=documind;Username=documind_user;Password=documind_secret

# AI Service Security & External LLMs
OPENAI_API_KEY=sk-your-openai-api-key-here
AI_SERVICE_API_KEY=documind-internal-ai-secret-key-32chars
EMBEDDING_PROVIDER=openai
LLM_PROVIDER=openai

# Optional: Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# JWT Authentication
JWT_SECRET=DocuMindEnterpriseSuperSecretKeyThatIsAtLeast32BytesLong!
JWT_ISSUER=DocuMindAPI
JWT_AUDIENCE=DocuMindClients
JWT_EXPIRY_HOURS=8

# Service Endpoints
AI_SERVICE_URL=http://localhost:8000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:4200

