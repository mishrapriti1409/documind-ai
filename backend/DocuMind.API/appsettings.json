{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=documind;Username=documind;Password=documind_password"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_SECURE_256_BIT_KEY_IN_PRODUCTION_ENV_DEVELOPMENT_ONLY_12345",
    "Issuer": "DocuMindAPI",
    "Audience": "DocuMindClient",
    "ExpirationHours": 8
  },
  "AIService": {
    "BaseUrl": "http://localhost:8001",
    "InternalApiKey": "dev_internal_secret_key_32_characters"
  },
  "Storage": {
    "StorageType": "local",
    "BasePath": "./storage/documents"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "RateLimit": {
    "Global": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "Chat": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  }
}
